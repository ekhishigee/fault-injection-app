# Copied to /etc/demo-target/env by install.sh (only if that file does not exist).
# systemd: EnvironmentFile=-/etc/demo-target/env
# After edits: sudo systemctl restart demo-controller demo-target

DEMO_RUNTIME=systemd
DEMO_DISK_MOUNT=/mnt/demo-disk

# Dashboard Application logs panel (GET /api/logs). CloudWatch on/off is a UI switch.
DEMO_APP_LOGS=1

# CloudWatch Logs destination. Credentials: instance role (preferred) or keys below.
AWS_REGION=ap-northeast-1
DEMO_CW_LOG_GROUP=/fault-inject/app
# DEMO_CW_LOG_STREAM=my-instance

# Only if there is no instance role. Do not commit these.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=
