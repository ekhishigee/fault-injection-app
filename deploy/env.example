# Copied to /etc/demo-target/env by install.sh (only if that file does not exist).
# systemd: EnvironmentFile=-/etc/demo-target/env
# After edits: sudo systemctl restart demo-controller demo-target

DEMO_RUNTIME=systemd
DEMO_DISK_MOUNT=/mnt/demo-disk

# Dashboard Application logs panel (GET /api/logs).
DEMO_APP_LOGS=1

# Local JSONL file. Point the CloudWatch agent at this path yourself.
# DEMO_APP_LOG_PATH=/var/lib/demo-faults/app.log
