# Copy to .env if you want to override Compose defaults.
DEMO_CONTROLLER_TOKEN=local-demo
DEMO_CONTROLLER_PORT=8080
DEMO_HTTP_PORT=80
# Isolated disk on a host that already has the loop mount:
# DEMO_DISK_HOST_PATH=/mnt/demo-disk
# DEMO_DISK_FILL_CAP_BYTES=0

# Application logs panel. Lines always go to the shared state volume as app.log.
# DEMO_APP_LOGS=1
# DEMO_APP_LOG_PATH=/var/lib/demo-faults/app.log
